# Server-only configuration. Copy to ignored .env.assistant.local.
# Leave provider local until the owner configures and enables Gemini.
ASSISTANT_PROVIDER=local
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
VILL_VOICE_NAME=Algieba
ASSISTANT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
