# Public deployment configuration. This is not a secret.
# Set this to the exact HTTPS origin shown by Amplify, without a path.
# Local development defaults to http://localhost:3000.
VITE_SITE_URL=http://localhost:3000

# Optional public contact settings. Never put passwords or mail API keys here.
# Use your own 30-minute Cal.com/Calendly event URL.
VITE_BOOKING_URL=
# Optional override; the portfolio already defaults to the owner’s public form below.
# The form sends directly with AJAX and never opens a mail app.
VITE_CONTACT_FORM_URL=https://formspree.io/f/xnpplzoz

# Optional public HTTPS assistant API base, ending in /api/assistant. Never place a key here.
VITE_ASSISTANT_API_URL=
