{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:dist": "node scripts/check-dist.mjs",
