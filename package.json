    "check:docs": "node scripts/check-docs.mjs",
    "verify:ci": "npm run test:ci && npm run check:assets && npm run check:unused && npm run check:docs && npm run build && npm run check:dist",
    "assistant:api": "node server/assistant.mjs",
    "assistant:package": "node scripts/package-assistant.mjs",
    "check:unused": "node scripts/check-unused.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "framer-motion": "^14.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.26",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
